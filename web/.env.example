# Environment for the web uploader.
#
# Copy to .env and fill in, or import it in Netlify under
# Site configuration -> Environment variables -> Import from a .env file.
# Never commit the filled-in copy: .env is gitignored.

# Your ShotGrid site, no trailing slash.
SHOTGRID_SITE=https://yourstudio.shotgrid.autodesk.com

# The project to upload into - the id test_connection.py prints.
SHOTGRID_PROJECT_ID=0

# Encrypts the sign-in cookie. 32+ random characters. Generate your own:
#   openssl rand -base64 48
# Changing it signs everyone out.
SESSION_SECRET=replace-with-output-of-openssl-rand-base64-48
