# Environment for the web uploader.
#
# Copy to .env and fill in, or import it in Netlify under
# Site configuration -> Environment variables -> Import from a .env file.
# Give every variable the Functions scope. Never commit the filled-in
# copy: .env is gitignored.

# Your ShotGrid site, no trailing slash.
SHOTGRID_SITE=https://yourstudio.shotgrid.autodesk.com

# The project to upload into - the id test_connection.py prints.
SHOTGRID_PROJECT_ID=0

# A ShotGrid script the functions sign in as (ShotGrid: avatar menu ->
# Admin -> Scripts). A separate script from the desktop app's lets you
# revoke one without breaking the other.
SHOTGRID_SCRIPT_NAME=web_uploader
SHOTGRID_SCRIPT_KEY=

# The Google Cloud OAuth client (Web application) for "Sign in with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only Google Workspace accounts on this domain can sign in.
ALLOWED_DOMAIN=softlinesolutions.com

# Encrypts the sign-in cookie. 32+ random characters. Generate your own:
#   openssl rand -base64 48
# Changing it signs everyone out.
SESSION_SECRET=
